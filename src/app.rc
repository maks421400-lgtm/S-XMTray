#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 ICON "../assets/quiet.ico"
2 ICON "../assets/anc.ico"
3 ICON "../assets/ambient.ico"
4 ICON "../assets/off.ico"
1 VERSIONINFO
FILEVERSION 0,5,1,0
PRODUCTVERSION 0,5,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "S-XMTray - WF-1000XM5 noise control\0"
   VALUE "FileVersion", "0.5.1\0"
   VALUE "ProductName", "S-XMTray\0"
   VALUE "ProductVersion", "0.5.1\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_PANEL DIALOGEX 0, 0, 240, 188
STYLE DS_SETFONT | WS_POPUP | NOT WS_CAPTION
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "S-XMTray"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Sony WF-1000XM5", IDC_PANEL_TITLE, 16, 16, 196, 17
 PUSHBUTTON "", IDC_UI_CLOSE, 216, 10, 16, 16
 LTEXT "", IDC_PANEL_STATUS, 16, 35, 208, 20
 CTEXT "", IDC_PANEL_BATTERY, 16, 66, 68, 20
 CTEXT "", IDC_PANEL_RIGHT, 86, 66, 68, 20
 CTEXT "", IDC_PANEL_CASE, 156, 66, 68, 20
 CTEXT "", IDC_PANEL_NOTE, 16, 90, 208, 12
 LTEXT "Noise control", IDC_PANEL_NOISE, 16, 102, 208, 12
 PUSHBUTTON "ANC", 101, 16, 120, 68, 26
 PUSHBUTTON "Ambient", 102, 86, 120, 68, 26
 PUSHBUTTON "Off", 103, 156, 120, 68, 26
 PUSHBUTTON "Settings", IDC_PANEL_SETTINGS, 16, 154, 208, 22
END

IDD_EQUALIZER DIALOGEX 0, 0, 378, 260
STYLE DS_SETFONT | WS_POPUP | NOT WS_CAPTION
CAPTION "S-XMTray - Equalizer"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Preset", IDC_EQ_PRESET_LABEL, 12, 15, 70, 12
 COMBOBOX IDC_EQ_PRESET, 88, 11, 278, 185, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_EQ_HINT, 12, 39, 354, 28
 CTEXT "Clear Bass", 320, 10, 72, 58, 12
 CTEXT "400 Hz", 321, 70, 72, 58, 12
 CTEXT "1 kHz", 322, 130, 72, 58, 12
 CTEXT "2.5 kHz", 323, 190, 72, 58, 12
 CTEXT "6.3 kHz", 324, 250, 72, 58, 12
 CTEXT "16 kHz", 325, 310, 72, 58, 12
 CONTROL "", 310, "msctls_trackbar32", WS_TABSTOP | TBS_VERT | TBS_AUTOTICKS, 26, 89, 28, 93
 CONTROL "", 311, "msctls_trackbar32", WS_TABSTOP | TBS_VERT | TBS_AUTOTICKS, 86, 89, 28, 93
 CONTROL "", 312, "msctls_trackbar32", WS_TABSTOP | TBS_VERT | TBS_AUTOTICKS, 146, 89, 28, 93
 CONTROL "", 313, "msctls_trackbar32", WS_TABSTOP | TBS_VERT | TBS_AUTOTICKS, 206, 89, 28, 93
 CONTROL "", 314, "msctls_trackbar32", WS_TABSTOP | TBS_VERT | TBS_AUTOTICKS, 266, 89, 28, 93
 CONTROL "", 315, "msctls_trackbar32", WS_TABSTOP | TBS_VERT | TBS_AUTOTICKS, 326, 89, 28, 93
 CTEXT "0", 330, 10, 184, 58, 12
 CTEXT "0", 331, 70, 184, 58, 12
 CTEXT "0", 332, 130, 184, 58, 12
 CTEXT "0", 333, 190, 184, 58, 12
 CTEXT "0", 334, 250, 184, 58, 12
 CTEXT "0", 335, 310, 184, 58, 12
 LTEXT "", IDC_EQ_STATUS, 12, 202, 354, 26
 PUSHBUTTON "Reset bands", IDC_EQ_RESET, 12, 233, 100, 20
 DEFPUSHBUTTON "Apply", IDOK, 208, 233, 76, 20
 PUSHBUTTON "Close", IDCANCEL, 290, 233, 76, 20
END

IDD_HOTKEYS DIALOGEX 0, 0, 300, 318
STYLE DS_SETFONT | WS_POPUP | NOT WS_CAPTION
CAPTION "S-XMTray - Hotkeys"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "Enable global hotkeys", IDC_HOTKEY_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 12, 268, 16
 LTEXT "Noise cancelling", IDC_LABEL_ANC, 16, 43, 268, 13
 CONTROL "", IDC_HOTKEY_ANC, "msctls_hotkey32", WS_TABSTOP, 16, 61, 202, 24
 PUSHBUTTON "Clear", IDC_CLEAR_ANC, 224, 61, 60, 24
 LTEXT "Ambient sound", IDC_LABEL_AMBIENT, 16, 98, 268, 13
 CONTROL "", IDC_HOTKEY_AMBIENT, "msctls_hotkey32", WS_TABSTOP, 16, 116, 202, 24
 PUSHBUTTON "Clear", IDC_CLEAR_AMBIENT, 224, 116, 60, 24
 LTEXT "Off", IDC_LABEL_OFF, 16, 153, 268, 13
 CONTROL "", IDC_HOTKEY_OFF, "msctls_hotkey32", WS_TABSTOP, 16, 171, 202, 24
 PUSHBUTTON "Clear", IDC_CLEAR_OFF, 224, 171, 60, 24
 LTEXT "", IDC_HOTKEY_HINT, 16, 207, 268, 29
 LTEXT "", IDC_HOTKEY_ERROR, 16, 239, 268, 26
 DEFPUSHBUTTON "Save", IDOK, 204, 278, 80, 25
 PUSHBUTTON "Cancel", IDCANCEL, 116, 278, 80, 25
END

IDD_SETTINGS DIALOGEX 0, 0, 260, 300
STYLE DS_SETFONT | WS_POPUP | NOT WS_CAPTION
CAPTION "S-XMTray - Settings"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Headphones", IDC_SETTINGS_DEVICE, 16, 8, 220, 12
 CONTROL "Speak-to-Chat", 130, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 24, 220, 20
 CONTROL "Hear my voice during calls", 131, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 48, 220, 20
 PUSHBUTTON "Equalizer and Clear Bass", 132, 16, 72, 220, 24
 PUSHBUTTON "Hotkeys", 121, 16, 100, 220, 24
 LTEXT "Appearance", IDC_SETTINGS_APPEARANCE, 16, 134, 220, 12
 PUSHBUTTON "System", 140, 16, 152, 72, 22
 PUSHBUTTON "Light", 141, 90, 152, 72, 22
 PUSHBUTTON "Dark", 142, 164, 152, 72, 22
 LTEXT "Language", IDC_SETTINGS_LANGUAGE, 16, 184, 220, 12
 PUSHBUTTON "System", 110, 16, 202, 72, 22
 PUSHBUTTON "Russian", 111, 90, 202, 72, 22
 PUSHBUTTON "English", 112, 164, 202, 72, 22
 CONTROL "Start with Windows", 120, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 232, 220, 20
 LTEXT "", IDC_SETTINGS_STATUS, 16, 260, 220, 20
 PUSHBUTTON "Reconnect", 104, 16, 284, 72, 22
 PUSHBUTTON "About", 106, 90, 284, 72, 22
 PUSHBUTTON "Exit", 105, 164, 284, 72, 22
END
